# Copy to .env and fill in values.

# PostgreSQL connection string (required). This one matches `compose.yaml`:
# docker compose up -d --wait
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dimah_starter

# Better Auth (required). At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). Authorized redirect URI:
# {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible object storage (required for uploads)
# Upload tickets. At least 32 characters, the same on every instance.
# openssl rand -base64 32
DIMAH_S3_SECRET=replace-with-a-long-random-secret
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=your-bucket-name
# Public base URL for object keys (CDN or public bucket; no trailing slash)
S3_PUBLIC_BASE_URL=https://your-cdn.example.com

# Google Search Console HTML-tag verification (optional). Content value only.
GOOGLE_SITE_VERIFICATION=

# Transactional email (Resend). Optional in development — messages are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Dimah Starter <noreply@example.com>"

