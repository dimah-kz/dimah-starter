{
  "name": "dimah-starter",
  "version": "0.0.1",
  "private": true,
  "description": "Server-first Turborepo starter for multi-tenant SaaS — Next.js dashboard, Better Auth, Postgres, and object storage.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "storage:purge": "pnpm --filter @repo/storage storage:purge",
    "typecheck": "turbo typecheck",
    "ui:sync": "pnpm --filter @repo/ui sync"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  }
}
