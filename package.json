{
  "name": "dimah-starter",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source, server-first Next.js 16 starter for multi-tenant SaaS: Better Auth, organizations and roles, admin panel, S3 uploads, Drizzle + Postgres, oRPC, and i18n with RTL.",
  "keywords": [
    "nextjs",
    "nextjs-starter",
    "saas",
    "saas-starter",
    "saas-boilerplate",
    "multi-tenant",
    "better-auth",
    "drizzle-orm",
    "postgresql",
    "orpc",
    "shadcn-ui",
    "tailwindcss",
    "turborepo",
    "server-actions",
    "react-server-components",
    "i18n",
    "rtl",
    "typescript"
  ],
  "homepage": "https://starter.dimah.dev",
  "bugs": "https://github.com/dimah-kz/dimah-starter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimah-kz/dimah-starter.git"
  },
  "license": "MIT",
  "author": "dimah-kz (https://github.com/dimah-kz)",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "storage:purge": "pnpm --filter @repo/storage storage:purge",
    "typecheck": "turbo typecheck",
    "ui:sync": "pnpm --filter @repo/ui sync"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  }
}
