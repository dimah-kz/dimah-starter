{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./s3-client": "./src/s3-client.tsx"
  },
  "scripts": {
    "lint": "eslint",
    "storage:generate": "tsx scripts/dimah-s3.ts generate latest -o ../db/src/schema/dimah-s3.schema.ts && pnpm -w exec prettier --write packages/db/src/schema/dimah-s3.schema.ts",
    "storage:purge": "tsx --env-file-if-exists=../../.env scripts/purge.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@dimah-s3/core": "catalog:",
    "@dimah-s3/db": "catalog:",
    "@dimah-s3/react": "catalog:",
    "@dimah-s3/server": "catalog:",
    "@fuma-translate/react": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
