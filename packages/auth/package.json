{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin-access": "./src/admin-access.ts",
    "./organization-access": "./src/organization-access.ts",
    "./app-origin": "./src/app-origin.ts",
    "./password-limits": "./src/password-limits.ts",
    "./paths": "./src/paths.ts",
    "./role-string": "./src/role-string.ts"
  },
  "scripts": {
    "auth:generate": "auth generate --config ./src/auth.ts --output ../db/src/schema/auth.schema.ts -y && pnpm -w exec prettier --write packages/db/src/schema/auth.schema.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.21",
    "@better-auth/i18n": "1.7.21",
    "@repo/db": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/i18n": "workspace:*",
    "better-auth": "1.7.21",
    "drizzle-orm": "rc"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "auth": "1.7.21",
    "eslint": "catalog:",
    "next": "16.4.6",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "next": "^16.0.0"
  }
}
