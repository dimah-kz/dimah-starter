{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin-access": "./src/admin-access.ts",
    "./organization-access": "./src/organization-access.ts",
    "./role-string": "./src/role-string.ts"
  },
  "scripts": {
    "auth:generate": "auth generate --config ./src/auth.ts --output ../db/src/schema/auth.schema.ts -y && pnpm -w exec prettier --write packages/db/src/schema/auth.schema.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@better-auth/i18n": "1.7.4",
    "@repo/db": "workspace:*",
    "@repo/i18n": "workspace:*",
    "better-auth": "1.7.4",
    "drizzle-orm": "rc"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "auth": "1.7.4",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
